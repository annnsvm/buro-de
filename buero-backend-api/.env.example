# --- Local development ---
# Start the local database first, from the repository root:  docker compose up -d
# It is your own copy: experiments here cannot affect real users.
DATABASE_URL="postgresql://buero:buero@localhost:5433/buero_dev?schema=public"

# Separate database for end-to-end tests, which delete and recreate data.
# Created automatically by docker compose. Never point this at the deployed database.
DATABASE_URL_TEST="postgresql://buero:buero@localhost:5433/buero_test?schema=public"
NODE_ENV="development"
PORT=3000

# Auth / JWT
JWT_ACCESS_SECRET="your-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie / CORS - local frontend (Vite)
COOKIE_DOMAIN=""
COOKIE_SECURE="false"
CORS_ORIGIN="http://localhost:5173"

# WayForPay - https://m.wayforpay.com → Налаштування → Технічні дані
# MERCHANT_ACCOUNT - логін мерчанта (не домен!)
WAYFORPAY_MERCHANT_ACCOUNT="your_merchant_login"
WAYFORPAY_MERCHANT_SECRET="your_merchant_secret_key"
# Домен рівно в тому вигляді, як зареєстрований у WayForPay (без протоколу)
WAYFORPAY_MERCHANT_DOMAIN="buro-de.com"
WAYFORPAY_CURRENCY="EUR"
# serviceUrl - server-to-server callback на бекенд. Локально: ngrok-тунель
WAYFORPAY_SERVICE_URL="http://localhost:3000/api/webhooks/wayforpay"
# returnUrl - необовʼязково; за замовчуванням ${WAYFORPAY_SERVICE_URL}/return
# WAYFORPAY_RETURN_URL="http://localhost:3000/api/webhooks/wayforpay/return"


# Rate limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Cloudinary (course covers) - https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact form email (Gmail SMTP + App Password)
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=burode452@gmail.com
SMTP_PASS=
CONTACT_INBOX=burode452@gmail.com
MAIL_FROM="Büro.de <burode452@gmail.com>"
# Absolute frontend URL for legal links in emails
PUBLIC_SITE_URL=https://www.buro-de.com
# Logo is embedded from assets/email/logo.png (CID). Optional public URL fallback:
# MAIL_LOGO_URL=https://www.buro-de.com/images/logo_light.webp

# --- Production on Render (Web Service buro-de) ---
# Only Render itself uses these. Do not copy the deployed DATABASE_URL into your
# local .env: local commands such as `prisma migrate` would then change live data.
# DATABASE_URL  = Internal Database URL (not External)
# NODE_ENV      = production
# CORS_ORIGIN   = https://www.buro-de.com
# COOKIE_SECURE = true
# WAYFORPAY_SERVICE_URL = https://buro-de.onrender.com/api/webhooks/wayforpay

# E2E (Jest): set automatically in test/setup-e2e-env.ts
# E2E_TEST=true

# ── Перевірка письмових завдань ───────────────────────────────────────────────
# Без ключа застосунок працює, але письмове завдання переходить у самоперевірку
# за зразком. Ключ береться на console.anthropic.com і ніде не комітиться.
ANTHROPIC_API_KEY=

# Модель і глибина міркувань - змінюються без деплою.
# Прогнано 02.11.2026 на 53 зразкових відповідях авторки і 10 оцінених листах:
# claude-opus-5-5 збігся з її оцінками в усіх 265 оцінках за критеріями,
# claude-sonnet-5-5 розійшовся в одній. Opus ~$0.0216, Sonnet ~$0.0107 за перевірку.
LLM_WRITING_MODEL=claude-opus-5-5
LLM_WRITING_EFFORT=low

# Скільки токенів відводиться на відповідь перевірника.
# На Opus мислення вимкнути неможливо, а воно білиться як вихід і витрачає той
# самий бюджет - тому там до відповіді додається запас, інакше JSON обривається
# посеред рядка. На Sonnet мислення справді вимкнене і запас не додається.
LLM_WRITING_MAX_OUTPUT_TOKENS=500
LLM_WRITING_THINKING_HEADROOM=1500

# Ліміти. Спрацьовують раніше за ліміт у консолі Anthropic, щоб студент бачив
# зрозуміле повідомлення, а не помилку API.
#
# Скільки перевірок дає одне завдання - це поле курсу (writing_checks_per_task,
# типово 3), а не змінна середовища: у різних курсів воно може бути різним.
# Пауза між спробами одного завдання, у секундах.
LLM_WRITING_COOLDOWN_SECONDS=30
# 0 або порожнє - ліміт вимкнено.
LLM_WRITING_DAILY_LIMIT=10
# 0 або порожнє - запобіжник вимкнено. Вмикати, коли підуть реальні студенти.
LLM_WRITING_MONTHLY_BUDGET_CHECKS=0
# Яка частка тексту мусить збігтися зі зразком, щоб його визнали копією.
# 0.8 виміряно на 2756 парах зразкових відповідей: чесний текст не перевищує 0.09.
LLM_WRITING_COPIED_SHARE=0.8
